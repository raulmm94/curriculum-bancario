{
  // Un único Worker de Cloudflare que solo sirve archivos estáticos (no hay código de servidor,
  // ni bases de datos, ni sesiones: la app habla directamente con tu Apps Script desde el navegador).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curriculum-bancario",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": true
}
