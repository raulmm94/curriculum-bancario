{
  // Un único Worker de Cloudflare, sin bindings: ni base de datos, ni KV, ni sesiones.
  // Solo sirve los archivos estáticos de ./public (empaquetados en dist/worker.js por el paso de
  // build); la app habla directamente con tu Apps Script desde el navegador.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curriculum-bancario",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node tools/construir-worker.mjs"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false }
}
